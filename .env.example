# Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# URL pública do app, usada para montar o link de indicação
# (https://SEU_DOMINIO/register?ref=CODIGO). Se não definida, usa window.location.origin.
VITE_APP_URL=https://imobquick.com.br

# URL do checkout de assinatura recorrente do Asaas (gerado no painel do Asaas)
VITE_CHECKOUT_URL=https://checkout.asaas.com/imobquick-mensal

# Valor exibido nas telas de assinatura (não afeta o valor real cobrado —
# esse valor é definido no plano criado dentro do painel do Asaas)
VITE_SUBSCRIPTION_PRICE=29,90

# ------------------------------------------------------------
# IMPORTANTE: a chave da OpenAI e as credenciais do Asaas (ASAAS_API_KEY,
# ASAAS_WEBHOOK_TOKEN) NÃO ficam aqui. Elas são configuradas como "secrets"
# das Edge Functions do Supabase (generate-property-texts e asaas-webhook),
# nunca expostas ao navegador. Veja o passo a passo no README, seções
# "Pagamento da assinatura (Asaas)" e "Sobre a chamada de IA e a Edge Function".
# ------------------------------------------------------------
